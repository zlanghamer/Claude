{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marketplace.claudecode.anthropic.com/schemas/plugin.schema.json",
  "title": "Claude Code Plugin Schema",
  "description": "JSON Schema for individual Claude Code plugin manifests",
  "type": "object",
  "required": ["name", "version", "description", "author", "category", "entry_point"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 2,
      "maxLength": 64,
      "description": "Unique plugin identifier in kebab-case"
    },
    "display_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "description": "Human-readable plugin name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.]+)?$",
      "description": "Semantic version string"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 512,
      "description": "Short description of what the plugin does"
    },
    "long_description": {
      "type": "string",
      "maxLength": 4096,
      "description": "Detailed description, supports Markdown"
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" },
        "github": { "type": "string" }
      }
    },
    "category": {
      "type": "string",
      "enum": ["code-intelligence", "integrations", "workflows", "learning"],
      "description": "Plugin category matching marketplace categories"
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "Searchable tags for the plugin"
    },
    "license": {
      "type": "string",
      "enum": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC"],
      "description": "SPDX license identifier"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["git"]
        },
        "url": { "type": "string", "format": "uri" },
        "directory": { "type": "string" }
      }
    },
    "entry_point": {
      "type": "string",
      "description": "Relative path to the plugin entry file"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string" },
        "platform": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["linux", "darwin", "win32"]
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "npm-style dependency map"
    },
    "peer_dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "file-read",
          "file-write",
          "network",
          "shell",
          "clipboard",
          "notifications",
          "settings"
        ]
      },
      "description": "Permissions the plugin requires"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "object",
          "description": "JSON Schema for plugin configuration options"
        },
        "defaults": {
          "type": "object",
          "description": "Default configuration values"
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "min_claude_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Minimum required Claude Code version"
    },
    "max_claude_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Maximum compatible Claude Code version"
    }
  }
}
