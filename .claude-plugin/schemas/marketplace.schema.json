{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marketplace.claudecode.anthropic.com/schemas/marketplace.schema.json",
  "title": "Claude Code Marketplace Schema",
  "description": "JSON Schema for the Claude Code plugin marketplace registry",
  "type": "object",
  "required": ["marketplace", "owner", "categories", "registry", "policies", "validation"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "marketplace": {
      "type": "object",
      "required": ["name", "version", "description", "homepage", "api_version", "last_updated"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "format": "uri" },
        "api_version": { "type": "string", "pattern": "^v\\d+$" },
        "last_updated": { "type": "string", "format": "date-time" }
      }
    },
    "owner": {
      "type": "object",
      "required": ["name", "url", "support_email", "security_email", "github"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "support_email": { "type": "string", "format": "email" },
        "security_email": { "type": "string", "format": "email" },
        "github": { "type": "string", "format": "uri" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "icon"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "minLength": 1 }
        }
      }
    },
    "registry": {
      "type": "object",
      "required": ["official_plugins", "community_plugins"],
      "additionalProperties": false,
      "properties": {
        "official_plugins": {
          "type": "array",
          "items": { "$ref": "#/definitions/plugin_entry" }
        },
        "community_plugins": {
          "type": "array",
          "items": { "$ref": "#/definitions/plugin_entry" }
        }
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "submission_review_days",
        "security_review_required",
        "min_test_coverage",
        "requires_semantic_versioning",
        "license_allowlist"
      ],
      "additionalProperties": false,
      "properties": {
        "submission_review_days": { "type": "integer", "minimum": 1 },
        "security_review_required": { "type": "boolean" },
        "min_test_coverage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "requires_semantic_versioning": { "type": "boolean" },
        "license_allowlist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["schema_version", "required_fields"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "required_fields": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "plugin_entry": {
      "type": "object",
      "required": ["id", "name", "version", "category", "repository"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "category": { "type": "string" },
        "repository": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "verified": { "type": "boolean" },
        "deprecated": { "type": "boolean" }
      }
    }
  }
}
